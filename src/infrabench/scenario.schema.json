{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InfraBench scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "category",
    "difficulty",
    "prompt",
    "context",
    "constraints",
    "checks",
    "reference_response"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "category": {
      "enum": [
        "linux",
        "docker",
        "networking",
        "security",
        "databases",
        "cloud",
        "incident-response"
      ]
    },
    "difficulty": {
      "enum": [
        "intermediate",
        "advanced"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "field",
          "operator",
          "values",
          "weight",
          "critical"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "field": {
            "enum": [
              "diagnosis",
              "actions",
              "verification",
              "rollback"
            ]
          },
          "operator": {
            "enum": [
              "contains_all",
              "contains_any",
              "excludes_all"
            ]
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            }
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "critical": {
            "type": "boolean"
          }
        }
      }
    },
    "reference_response": {
      "type": "object",
      "required": [
        "diagnosis",
        "actions",
        "verification",
        "rollback"
      ],
      "additionalProperties": false,
      "properties": {
        "diagnosis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "actions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "verification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "rollback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    }
  }
}
