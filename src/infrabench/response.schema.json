{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InfraBench responses v1",
  "type": "object",
  "required": [
    "schema_version",
    "agent",
    "responses"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "diagnosis",
          "actions",
          "verification",
          "rollback"
        ],
        "additionalProperties": false,
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "diagnosis": {
            "type": "string",
            "maxLength": 20000
          },
          "actions": {
            "type": "string",
            "maxLength": 20000
          },
          "verification": {
            "type": "string",
            "maxLength": 20000
          },
          "rollback": {
            "type": "string",
            "maxLength": 20000
          }
        }
      }
    }
  }
}
